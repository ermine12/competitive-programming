class Solution(object):
    def reductionOperations(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """

        nums.sort()
        total_ops = 0
        up_steps = 0
        
        for i in range(1, len(nums)):
            
            if nums[i] > nums[i-1]:
                up_steps += 1
            
            total_ops += up_steps
            
        return total_ops
        