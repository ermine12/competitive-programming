class Solution:
    def convert(self, s: str, numRows: int) -> str:
        # If only one row or string too short, no zigzag needed
        if numRows == 1 or numRows >= len(s):
            return s

        # Prepare rows as buckets for characters
        rows = [""] * numRows
        cur_row = 0
        going_down = False

        # Place each character in the right row
        for char in s:
            rows[cur_row] += char
            # Flip direction at top or bottom
            if cur_row == 0 or cur_row == numRows - 1:
                going_down = not going_down
            cur_row += 1 if going_down else -1

        # Stitch rows together
        return "".join(rows)
