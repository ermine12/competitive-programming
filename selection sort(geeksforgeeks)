class Solution: 
    def selectionSort(self, arr):
        l = len(arr)
        
        for i in range(l):
            min_val = arr[i]   
            for j in range(i+1, l):   
                if min_val > arr[j]:
                    min_val = arr[j]
                    arr[j] = arr[i]
                    arr[i] = min_val
                    
        return arr
