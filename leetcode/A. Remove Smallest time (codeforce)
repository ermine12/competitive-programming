import sys


input_data = sys.stdin.read().split()
if input_data:
    t = int(input_data[0])
    current = 1

    for _ in range(t):
        n = int(input_data[current])
        current += 1
        
        a = [int(x) for x in input_data[current : current + n]]
        current += n

        
        a.sort()
        
        
        possible = True
       
        for i in range(1, n):
           
            if a[i] - a[i-1] > 1:
                possible = False
                break
        

        if possible:
            print("YES")
        else:
            print("NO")
