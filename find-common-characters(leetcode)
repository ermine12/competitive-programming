class Solution:
    def commonChars(self, words):
        result = []
        first = words[0]

        for ch in first:
            found = True
            for i in range(1, len(words)):
                if ch not in words[i]:
                    found = False
                    break
            if found:
                result.append(ch)
                for i in range(len(words)):
                    words[i] = words[i].replace(ch, "", 1)

        return result
